/// Daily marketing performance at date, channel, campaign, product, region, and device grain.
table 'Marketing Performance'

	/// Total number of advertising or content impressions in the current filter context.
	measure 'Total Impressions' = SUM('Marketing Performance'[Impressions])
		formatString: #,##0
		displayFolder: Reach and Traffic

	/// Total number of clicks generated by marketing activity.
	measure 'Total Clicks' = SUM('Marketing Performance'[Clicks])
		formatString: #,##0
		displayFolder: Reach and Traffic

	/// Total attributed website sessions generated by marketing activity.
	measure 'Total Sessions' = SUM('Marketing Performance'[Sessions])
		formatString: #,##0
		displayFolder: Reach and Traffic

	/// Total marketing media spend in US dollars.
	measure 'Total Spend' = SUM('Marketing Performance'[Spend])
		formatString: $#,##0.00
		displayFolder: Investment and Return

	/// Total attributed revenue in US dollars.
	measure 'Total Revenue' = SUM('Marketing Performance'[Revenue])
		formatString: $#,##0.00
		displayFolder: Investment and Return

	/// Total attributed conversion events.
	measure 'Total Conversions' = SUM('Marketing Performance'[Conversions])
		formatString: #,##0
		displayFolder: Outcomes

	/// Total qualified or captured leads attributed to marketing activity.
	measure 'Total Leads' = SUM('Marketing Performance'[Leads])
		formatString: #,##0
		displayFolder: Outcomes

	/// Share of impressions that generated a click; blank when impressions are zero.
	measure 'Click-Through Rate' = DIVIDE([Total Clicks], [Total Impressions])
		formatString: 0.00%
		displayFolder: Efficiency

	/// Share of attributed sessions that generated a conversion; blank when sessions are zero.
	measure 'Conversion Rate' = DIVIDE([Total Conversions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Efficiency

	/// Average media spend required to generate one click; blank when clicks are zero.
	measure 'Cost per Click' = DIVIDE([Total Spend], [Total Clicks])
		formatString: $#,##0.00
		displayFolder: Efficiency

	/// Average media spend required to generate one lead; blank when leads are zero.
	measure 'Cost per Lead' = DIVIDE([Total Spend], [Total Leads])
		formatString: $#,##0.00
		displayFolder: Efficiency

	/// Attributed revenue divided by media spend; blank for organic activity with zero spend.
	measure 'Return on Ad Spend' = DIVIDE([Total Revenue], [Total Spend])
		formatString: 0.00x
		displayFolder: Investment and Return

	/// Numeric calendar key used to relate performance to the Date dimension.
	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	/// Integer key used to relate performance to the Channel dimension.
	column 'Channel Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: channel_key

	/// Integer key used to relate performance to the Campaign dimension.
	column 'Campaign Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: campaign_key

	/// Integer key used to relate performance to the Product dimension.
	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	/// Geographic market assigned to the generated marketing signal.
	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	/// Device class associated with the generated user activity.
	column 'Device Category'
		dataType: string
		summarizeBy: none
		sourceColumn: device_category

	column Impressions
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: impressions

	column Clicks
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: clicks

	column Sessions
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: sessions

	column Spend
		dataType: decimal
		isHidden
		formatString: $#,##0.00
		summarizeBy: sum
		sourceColumn: spend

	column Conversions
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: conversions

	column Leads
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: leads

	column Revenue
		dataType: decimal
		isHidden
		formatString: $#,##0.00
		summarizeBy: sum
		sourceColumn: revenue

	/// Video plays attributed to supported social platforms; zero for unsupported platforms.
	column 'Video Views'
		dataType: int64
		summarizeBy: sum
		sourceColumn: video_views

	/// Social interactions such as reactions or comments; zero for channels without engagement signals.
	column Engagements
		dataType: int64
		summarizeBy: sum
		sourceColumn: engagements

	partition 'Marketing Performance' = entity
		mode: directLake
		source
			entityName: fct_marketing_performance
			schemaName: facts
			expressionSource: 'DirectLake - Marketing Hub'

